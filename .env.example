APP_NAME="Pustaka Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Laravel session
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Local application stores
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Firebase / Firestore
FIREBASE_PROJECT=app
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_DEFAULT_BUCKET=

# Library settings
BORROWING_DAYS=14
FINE_PER_DAY=1000
